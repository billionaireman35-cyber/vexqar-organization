.app-shell {
  min-height: 100vh;
  display: flex;
  color: var(--text);
  background:
    radial-gradient(circle at 50% -10%, rgba(139, 92, 246, 0.08), transparent 30rem),
    transparent;
}

.app-shell a {
  text-decoration: none;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 40;
  width: 272px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--border);
  background: rgba(7, 8, 13, 0.82);
  backdrop-filter: blur(26px);
  -webkit-backdrop-filter: blur(26px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
  height: 82px;
  padding: 0 22px;
  border-bottom: 1px solid var(--border);
}

.brand-mark {
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 0 30px rgba(109, 40, 217, 0.2);
}

.brand-mark img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
}

.brand strong {
  display: block;
  color: var(--text-bright);
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.brand small {
  display: block;
  margin-top: 3px;
  color: var(--text-soft);
  font-family: var(--mono);
  font-size: 0.63rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.navigation {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 5px;
  padding: 24px 14px;
  overflow-y: auto;
}

.nav-label {
  padding: 0 12px 9px;
  color: #525a6d;
  font-family: var(--mono);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.navigation a {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 43px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 11px;
  color: #80889c;
  font-size: 0.87rem;
  transition:
    color 180ms ease,
    background 180ms ease,
    border-color 180ms ease,
    transform 180ms ease;
}

.navigation a:hover {
  color: #dfe3ed;
  background: rgba(255, 255, 255, 0.035);
  border-color: var(--border);
  transform: translateX(2px);
}

.navigation a.active {
  color: #fff;
  background:
    linear-gradient(90deg, rgba(109, 40, 217, 0.2), rgba(109, 40, 217, 0.06));
  border-color: rgba(139, 92, 246, 0.2);
  box-shadow: inset 2px 0 0 var(--violet);
}

.navigation a svg {
  width: 17px;
  height: 17px;
}

.sidebar-footer {
  padding: 17px;
  border-top: 1px solid var(--border);
}

.company-signature {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 0 4px 13px;
}

.company-signature span {
  color: #525a6d;
  font-family: var(--mono);
  font-size: 0.56rem;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.company-signature strong {
  color: #8e96a9;
  font-size: 0.64rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.network-indicator {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 11px 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.025);
  color: #8e96a9;
  font-family: var(--mono);
  font-size: 0.66rem;
  letter-spacing: 0.04em;
}

.live-dot {
  width: 6px;
  height: 6px;
  flex: 0 0 6px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 12px rgba(52, 211, 153, 0.7);
}

.main-content {
  width: calc(100% - 272px);
  min-width: 0;
  min-height: 100vh;
  margin-left: 272px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 66px;
  padding: 0 34px;
  border-bottom: 1px solid var(--border);
  background: rgba(7, 8, 13, 0.66);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.topbar-context {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #8e96a9;
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.live-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 9px;
  border: 1px solid rgba(52, 211, 153, 0.18);
  border-radius: 999px;
  color: #7ce7b9;
  background: rgba(52, 211, 153, 0.055);
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.mobile-menu {
  display: none;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text);
  background: rgba(255, 255, 255, 0.03);
}

.page-content {
  width: min(100%, 1440px);
  margin: 0 auto;
  padding: 72px 54px 100px;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
  gap: 50px;
  align-items: center;
  min-height: 650px;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
  color: #8b95aa;
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.eyebrow-line {
  width: 34px;
  height: 1px;
  background: linear-gradient(90deg, var(--cyan), transparent);
}

.hero-copy h1 {
  max-width: 850px;
}

.hero-copy h1 span {
  background: linear-gradient(110deg, #fff 10%, #b7a1ff 48%, #67e8f9 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-copy > p {
  max-width: 660px;
  margin-top: 28px;
  color: #8d95a8;
  font-size: 1.02rem;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 11px;
  margin-top: 34px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 46px;
  padding: 0 17px;
  border-radius: 10px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease;
}

.primary-button {
  color: #fff;
  border: 1px solid rgba(139, 92, 246, 0.55);
  background: linear-gradient(135deg, #7c3aed, #5b21b6);
  box-shadow: 0 10px 30px rgba(91, 33, 182, 0.25);
}

.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-2px);
}

.primary-button:hover {
  box-shadow: 0 14px 40px rgba(91, 33, 182, 0.34);
}

.secondary-button {
  color: #d4d8e3;
  border: 1px solid var(--border-strong);
  background: rgba(255, 255, 255, 0.035);
}

.secondary-button:hover {
  border-color: rgba(139, 92, 246, 0.35);
  background: rgba(255, 255, 255, 0.055);
}

.hero-panel {
  position: relative;
  min-height: 510px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 28px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 48%, rgba(109, 40, 217, 0.16), transparent 13rem),
    radial-gradient(circle at 50% 50%, rgba(34, 211, 238, 0.045), transparent 20rem),
    rgba(9, 10, 17, 0.68);
  box-shadow: var(--shadow-lg), var(--shadow-glow);
}

.hero-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, transparent 49.8%, rgba(139, 92, 246, 0.08) 50%, transparent 50.2%),
    linear-gradient(0deg, transparent 49.8%, rgba(139, 92, 246, 0.08) 50%, transparent 50.2%);
  background-size: 100% 100%;
  pointer-events: none;
}

.hero-orbit {
  position: relative;
  width: min(390px, 75vw);
  aspect-ratio: 1;
  display: grid;
  place-items: center;
}

.orbit {
  position: absolute;
  border: 1px solid rgba(139, 92, 246, 0.18);
  border-radius: 50%;
  transform: rotate(-22deg) rotateX(62deg);
}

.orbit-one {
  width: 94%;
  height: 40%;
}

.orbit-two {
  width: 75%;
  height: 29%;
  transform: rotate(42deg) rotateX(62deg);
  border-color: rgba(34, 211, 238, 0.16);
}

.orbit-core {
  position: relative;
  z-index: 2;
  width: 42%;
  aspect-ratio: 1;
  padding: 3%;
  border: 1px solid rgba(139, 92, 246, 0.35);
  border-radius: 30px;
  background: rgba(10, 11, 19, 0.5);
  box-shadow:
    0 0 80px rgba(109, 40, 217, 0.24),
    inset 0 0 40px rgba(139, 92, 246, 0.08);
}

.orbit-core img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
  border-radius: 22px;
}

.section-block {
  margin-top: 74px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.section-heading p {
  max-width: 620px;
  color: var(--text-soft);
  font-size: 0.9rem;
  line-height: 1.65;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.metric-card,
.module-card,
.protocol-strip,
.placeholder-page {
  border: 1px solid var(--border);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.018));
  box-shadow: 0 14px 50px rgba(0, 0, 0, 0.14);
}

.metric-card {
  min-height: 132px;
  padding: 22px;
  border-radius: 15px;
}

.metric-card small {
  display: block;
  color: #626b7e;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.metric-card strong {
  display: block;
  margin-top: 14px;
  color: #f7f8fc;
  font-family: var(--mono);
  font-size: 1.18rem;
  letter-spacing: -0.03em;
}

.metric-card p {
  margin-top: 5px;
  color: #697285;
  font-size: 0.74rem;
}

.metric-live strong {
  color: #76e5b6;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 11px;
}

.module-card {
  min-height: 205px;
  padding: 23px;
  border-radius: 16px;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.module-card:hover {
  transform: translateY(-3px);
  border-color: var(--border-strong);
  background:
    linear-gradient(145deg, rgba(139, 92, 246, 0.075), rgba(255, 255, 255, 0.025));
}

.module-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
}

.module-icon,
.protocol-icon,
.placeholder-icon {
  display: grid;
  place-items: center;
  border: 1px solid rgba(139, 92, 246, 0.22);
  color: #b49aff;
  background: var(--violet-soft);
}

.module-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
}

.module-icon svg {
  width: 18px;
  height: 18px;
}

.module-card h3 {
  margin-top: 25px;
}

.module-card p {
  margin-top: 8px;
  color: #737c90;
  font-size: 0.79rem;
  line-height: 1.6;
}

.module-arrow {
  color: #515a6e;
  transition: color 180ms ease, transform 180ms ease;
}

.module-card:hover .module-arrow {
  color: var(--cyan);
  transform: translate(2px, -2px);
}

.protocol-strip {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 18px;
  align-items: center;
  padding: 22px;
  border-radius: 15px;
  background:
    linear-gradient(110deg, rgba(109, 40, 217, 0.095), rgba(34, 211, 238, 0.025)),
    rgba(255, 255, 255, 0.02);
}

.protocol-icon {
  width: 42px;
  height: 42px;
  border-radius: 11px;
}

.protocol-strip strong {
  color: #e8eaf1;
  font-size: 0.84rem;
}

.protocol-strip p {
  margin-top: 3px;
  color: #727b8f;
  font-size: 0.76rem;
}

.external-link,
.text-link {
  color: #b4a1ff;
  transition: color 180ms ease;
}

.external-link:hover,
.text-link:hover {
  color: var(--cyan);
}

.placeholder-page {
  min-height: 620px;
  display: grid;
  place-items: center;
  padding: 50px;
  border-radius: 22px;
  text-align: center;
  background:
    radial-gradient(circle at center, rgba(109, 40, 217, 0.09), transparent 22rem),
    rgba(255, 255, 255, 0.018);
}

.placeholder-page > div {
  max-width: 660px;
}

.placeholder-icon {
  width: 62px;
  height: 62px;
  margin: 0 auto 24px;
  border-radius: 17px;
}

.placeholder-page h2 {
  margin-bottom: 13px;
}

.placeholder-page p {
  color: #747d90;
  line-height: 1.75;
}

.sidebar-backdrop {
  display: none;
}

@media (max-width: 1180px) {
  .sidebar {
    width: 238px;
  }

  .main-content {
    width: calc(100% - 238px);
    margin-left: 238px;
  }

  .page-content {
    padding-inline: 34px;
  }

  .hero-grid {
    gap: 30px;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .sidebar {
    transform: translateX(-102%);
    transition: transform 220ms ease;
    box-shadow: 20px 0 60px rgba(0, 0, 0, 0.45);
  }

  .sidebar.sidebar-open {
    transform: translateX(0);
  }

  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    z-index: 35;
    display: block;
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(4px);
  }

  .main-content {
    width: 100%;
    margin-left: 0;
  }

  .mobile-menu {
    display: inline-flex;
  }

  .topbar {
    padding-inline: 20px;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .hero-copy {
    padding-top: 24px;
  }

  .hero-panel {
    min-height: 420px;
  }

  .module-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .page-content {
    padding: 40px 17px 70px;
  }

  .topbar {
    height: 60px;
  }

  .topbar-context {
    font-size: 0.6rem;
  }

  .hero-grid {
    gap: 28px;
  }

  .hero-copy h1 {
    font-size: clamp(2.65rem, 14vw, 4rem);
  }

  .hero-copy > p {
    font-size: 0.92rem;
  }

  .hero-panel {
    min-height: 350px;
    border-radius: 20px;
  }

  .metrics-grid,
  .module-grid {
    grid-template-columns: 1fr;
  }

  .section-block {
    margin-top: 52px;
  }

  .section-heading {
    display: block;
  }

  .section-heading p {
    margin-top: 9px;
  }

  .protocol-strip {
    grid-template-columns: 1fr;
  }

  .placeholder-page {
    min-height: 500px;
    padding: 30px 20px;
  }
}

/* VXR protocol page */
.vxr-page {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.vxr-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
  gap: 44px;
  align-items: stretch;
  margin-bottom: 28px;
}

.vxr-hero-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 430px;
}

.vxr-hero-copy h1 {
  max-width: 780px;
  margin: 18px 0;
  color: var(--text-bright);
  font-size: clamp(3rem, 6vw, 5.8rem);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.vxr-hero-copy h1 span {
  display: block;
  color: #a78bfa;
}

.vxr-hero-copy > p {
  max-width: 680px;
  color: var(--text-soft);
  font-size: 1rem;
  line-height: 1.8;
}

.vxr-actions {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 30px;
}

.vxr-live-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #7ce7b9;
  font-family: var(--mono);
  font-size: 0.64rem;
  letter-spacing: 0.09em;
}

.vxr-supply-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 430px;
  padding: 38px;
  overflow: hidden;
  border: 1px solid rgba(139, 92, 246, 0.24);
  border-radius: 26px;
  background:
    radial-gradient(circle at 80% 15%, rgba(34, 211, 238, 0.08), transparent 35%),
    radial-gradient(circle at 20% 90%, rgba(139, 92, 246, 0.13), transparent 42%),
    rgba(11, 12, 20, 0.76);
  box-shadow:
    0 30px 90px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
}

.vxr-supply-card::after {
  content: '';
  position: absolute;
  width: 230px;
  height: 230px;
  right: -80px;
  bottom: -90px;
  border: 1px solid rgba(34, 211, 238, 0.14);
  border-radius: 50%;
  box-shadow:
    0 0 0 35px rgba(34, 211, 238, 0.025),
    0 0 0 70px rgba(139, 92, 246, 0.025);
}

.vxr-supply-card > span {
  color: #687186;
  font-family: var(--mono);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.14em;
}

.vxr-supply-card > strong {
  margin: 13px 0 4px;
  color: var(--text-bright);
  font-size: clamp(2.4rem, 4vw, 4.2rem);
  line-height: 1;
  letter-spacing: -0.05em;
}

.vxr-supply-card > small {
  color: #7e879a;
  font-family: var(--mono);
  font-size: 0.68rem;
}

.vxr-card-divider {
  width: 100%;
  height: 1px;
  margin: 35px 0 24px;
  background: var(--border);
}

.vxr-card-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.vxr-card-meta span {
  display: flex;
  flex-direction: column;
  gap: 5px;
  color: #a0a8ba;
  font-size: 0.82rem;
}

.vxr-card-meta b {
  color: #596276;
  font-family: var(--mono);
  font-size: 0.58rem;
  letter-spacing: 0.1em;
}

.vxr-contract {
  display: grid;
  grid-template-columns: minmax(180px, 0.5fr) minmax(280px, 1.5fr) auto;
  gap: 20px;
  align-items: center;
  padding: 18px 22px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.022);
}

.vxr-contract > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.vxr-contract > div .eyebrow {
  font-size: 0.56rem;
}

.vxr-contract > div strong {
  color: var(--text-bright);
  font-size: 0.83rem;
  letter-spacing: 0.04em;
}

.vxr-contract code {
  min-width: 0;
  overflow: hidden;
  color: #8e96a9;
  font-family: var(--mono);
  font-size: 0.7rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vxr-section {
  margin-top: 76px;
}

.constitution-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.constitution-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  min-height: 82px;
  padding: 19px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.018);
  color: #a5adbe;
  font-size: 0.78rem;
  line-height: 1.55;
  transition:
    border-color 180ms ease,
    background 180ms ease,
    transform 180ms ease;
}

.constitution-item:hover {
  transform: translateY(-2px);
  border-color: rgba(139, 92, 246, 0.22);
  background: rgba(139, 92, 246, 0.035);
}

.constitution-item svg {
  flex: 0 0 auto;
  margin-top: 1px;
  color: #8b5cf6;
}

.allocation-list {
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--border);
}

.allocation-row {
  display: grid;
  grid-template-columns: minmax(190px, 0.75fr) minmax(160px, 1.25fr) 170px;
  gap: 24px;
  align-items: center;
  min-height: 70px;
  border-bottom: 1px solid var(--border);
}

.allocation-name {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  color: #c2c8d5;
  font-size: 0.82rem;
}

.allocation-name small {
  color: #687186;
  font-family: var(--mono);
  font-size: 0.62rem;
}

.allocation-track {
  height: 5px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.055);
}

.allocation-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #6d28d9, #22d3ee);
}

.allocation-row > strong {
  color: #9ea7ba;
  font-family: var(--mono);
  font-size: 0.68rem;
  font-weight: 500;
  text-align: right;
}

.vxr-bottom-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-top: 76px;
}

.vxr-info-card {
  min-height: 210px;
  padding: 28px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background:
    linear-gradient(135deg, rgba(139, 92, 246, 0.045), transparent 50%),
    rgba(255, 255, 255, 0.018);
}

.vxr-info-card > strong {
  display: block;
  margin: 12px 0 11px;
  color: var(--text-bright);
  font-size: 1.45rem;
  letter-spacing: -0.025em;
}

.vxr-info-card > p {
  max-width: 620px;
  color: #7d8699;
  font-size: 0.82rem;
  line-height: 1.75;
}

@media (max-width: 1000px) {
  .vxr-hero {
    grid-template-columns: 1fr;
  }

  .vxr-hero-copy {
    min-height: auto;
  }

  .vxr-supply-card {
    min-height: 330px;
  }

  .constitution-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .vxr-contract {
    grid-template-columns: 1fr;
  }

  .vxr-contract .text-link {
    justify-self: start;
  }
}

@media (max-width: 700px) {
  .vxr-hero-copy h1 {
    font-size: clamp(2.7rem, 13vw, 4.2rem);
  }

  .vxr-actions {
    align-items: flex-start;
    flex-direction: column;
  }

  .vxr-supply-card {
    min-height: 300px;
    padding: 27px;
  }

  .constitution-grid,
  .vxr-bottom-grid {
    grid-template-columns: 1fr;
  }

  .allocation-row {
    grid-template-columns: 1fr auto;
    gap: 8px 15px;
    padding: 17px 0;
  }

  .allocation-name {
    grid-column: 1 / -1;
  }

  .allocation-track {
    grid-column: 1;
  }

  .allocation-row > strong {
    grid-column: 2;
  }
}

/* Architecture page */
.architecture-page {
  display: flex;
  flex-direction: column;
  gap: 72px;
  padding-bottom: 80px;
}

.architecture-hero {
  min-height: 440px;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
  gap: 42px;
  align-items: center;
}

.architecture-hero-copy {
  max-width: 760px;
}

.architecture-hero-copy h1 {
  margin: 20px 0 22px;
  max-width: 760px;
  font-size: clamp(2.8rem, 5vw, 5.25rem);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.architecture-hero-copy h1 span {
  display: block;
  color: var(--accent);
}

.architecture-hero-copy p {
  max-width: 680px;
  margin: 0;
  color: var(--text-muted);
  font-size: 1.05rem;
  line-height: 1.85;
}

.architecture-hero-panel {
  position: relative;
  min-height: 400px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 28px;
  background:
    radial-gradient(circle at center, rgba(109, 40, 217, 0.18), transparent 34%),
    radial-gradient(circle at 50% 50%, rgba(34, 211, 238, 0.07), transparent 58%),
    rgba(9, 10, 17, 0.62);
  box-shadow:
    inset 0 0 70px rgba(109, 40, 217, 0.06),
    0 30px 90px rgba(0, 0, 0, 0.24);
}

.architecture-hero-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0.35;
  background-image:
    linear-gradient(rgba(139, 92, 246, 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(139, 92, 246, 0.07) 1px, transparent 1px);
  background-size: 38px 38px;
  mask-image: radial-gradient(circle at center, black 20%, transparent 76%);
}

.architecture-node {
  position: relative;
  z-index: 4;
  width: 150px;
  height: 150px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 7px;
  border: 1px solid rgba(139, 92, 246, 0.55);
  border-radius: 32px;
  background: rgba(10, 11, 19, 0.88);
  box-shadow:
    0 0 55px rgba(109, 40, 217, 0.22),
    inset 0 0 35px rgba(139, 92, 246, 0.08);
  text-align: center;
}

.architecture-node span {
  color: #fff;
  font-size: 1.05rem;
  font-weight: 750;
  letter-spacing: 0.12em;
}

.architecture-node small {
  color: var(--text-soft);
  font-family: var(--mono);
  font-size: 0.5rem;
  letter-spacing: 0.1em;
}

.architecture-orbit {
  position: absolute;
  border: 1px solid rgba(139, 92, 246, 0.24);
  border-radius: 999px;
  transform: rotate(-18deg);
}

.architecture-orbit::after {
  content: '';
  position: absolute;
  top: 50%;
  left: -4px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 18px rgba(139, 92, 246, 0.9);
}

.architecture-orbit-one {
  width: 240px;
  height: 240px;
}

.architecture-orbit-two {
  width: 330px;
  height: 190px;
  transform: rotate(34deg);
  border-color: rgba(34, 211, 238, 0.18);
}

.architecture-orbit-two::after {
  background: var(--cyan);
  box-shadow: 0 0 18px rgba(34, 211, 238, 0.8);
  top: auto;
  bottom: -4px;
  left: 50%;
}

.architecture-orbit-three {
  width: 410px;
  height: 290px;
  transform: rotate(-54deg);
  border-color: rgba(139, 92, 246, 0.12);
}

.architecture-orbit-three::after {
  top: 20%;
  left: auto;
  right: -4px;
}

.architecture-principles {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: var(--border);
}

.architecture-principles article {
  min-height: 210px;
  padding: 30px;
  background: rgba(11, 12, 20, 0.82);
}

.architecture-principles article + article {
  border-left: 1px solid var(--border);
}

.architecture-principles strong {
  display: block;
  margin: 14px 0 10px;
  color: var(--text);
  font-size: 1.05rem;
  line-height: 1.35;
}

.architecture-principles p {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.86rem;
  line-height: 1.75;
}

.architecture-section {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.architecture-stack {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.architecture-stack::before {
  content: '';
  position: absolute;
  top: 26px;
  bottom: 26px;
  left: 41px;
  width: 1px;
  background: linear-gradient(
    to bottom,
    rgba(139, 92, 246, 0),
    rgba(139, 92, 246, 0.4) 10%,
    rgba(139, 92, 246, 0.4) 90%,
    rgba(139, 92, 246, 0)
  );
}

.architecture-layer {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 52px 54px minmax(0, 1fr);
  gap: 20px;
  align-items: start;
  padding: 25px 28px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background:
    linear-gradient(110deg, rgba(139, 92, 246, 0.035), transparent 38%),
    rgba(10, 11, 18, 0.72);
  transition:
    border-color 180ms ease,
    transform 180ms ease,
    background 180ms ease;
}

.architecture-layer:hover {
  border-color: rgba(139, 92, 246, 0.32);
  background:
    linear-gradient(110deg, rgba(139, 92, 246, 0.06), transparent 42%),
    rgba(12, 13, 22, 0.84);
  transform: translateX(3px);
}

.architecture-layer-index {
  padding-top: 7px;
  color: #596174;
  font-family: var(--mono);
  font-size: 0.67rem;
  letter-spacing: 0.08em;
}

.architecture-layer-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(139, 92, 246, 0.2);
  border-radius: 15px;
  color: var(--accent);
  background: rgba(109, 40, 217, 0.07);
}

.architecture-layer-main {
  min-width: 0;
}

.architecture-layer-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.architecture-layer-kicker {
  display: block;
  margin-bottom: 5px;
  color: #687086;
  font-family: var(--mono);
  font-size: 0.58rem;
  letter-spacing: 0.1em;
}

.architecture-layer h3 {
  margin: 0;
  color: var(--text);
  font-size: 1.12rem;
  letter-spacing: -0.015em;
}

.architecture-status {
  flex: 0 0 auto;
  padding: 5px 8px;
  border: 1px solid currentColor;
  border-radius: 999px;
  font-family: var(--mono);
  font-size: 0.53rem;
  letter-spacing: 0.08em;
}

.architecture-layer p {
  max-width: 820px;
  margin: 12px 0 17px;
  color: var(--text-muted);
  font-size: 0.86rem;
  line-height: 1.72;
}

.architecture-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.architecture-facts span {
  padding: 5px 8px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 7px;
  color: #7f8799;
  background: rgba(255, 255, 255, 0.018);
  font-family: var(--mono);
  font-size: 0.55rem;
}

.architecture-boundary {
  display: grid;
  grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
  gap: 30px;
  padding: 34px;
  border: 1px solid var(--border);
  border-radius: 24px;
  background:
    radial-gradient(circle at 0% 0%, rgba(109, 40, 217, 0.1), transparent 42%),
    rgba(10, 11, 18, 0.72);
}

.architecture-boundary h2 {
  max-width: 430px;
  margin: 15px 0 0;
  font-size: clamp(1.65rem, 3vw, 2.45rem);
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.boundary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.boundary-grid > div {
  min-height: 112px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6px;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.018);
}

.boundary-grid svg {
  color: var(--accent);
}

.boundary-grid strong {
  color: var(--text);
  font-size: 0.82rem;
}

.boundary-grid span {
  color: var(--text-soft);
  font-family: var(--mono);
  font-size: 0.56rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

@media (max-width: 1050px) {
  .architecture-hero {
    grid-template-columns: 1fr;
  }

  .architecture-hero-panel {
    min-height: 340px;
  }

  .architecture-boundary {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .architecture-page {
    gap: 52px;
  }

  .architecture-hero-copy h1 {
    font-size: clamp(2.55rem, 11vw, 4rem);
  }

  .architecture-principles {
    grid-template-columns: 1fr;
  }

  .architecture-principles article {
    min-height: auto;
  }

  .architecture-principles article + article {
    border-top: 1px solid var(--border);
    border-left: 0;
  }

  .architecture-layer {
    grid-template-columns: 40px 48px minmax(0, 1fr);
    gap: 12px;
    padding: 20px;
  }

  .architecture-stack::before {
    left: 39px;
  }

  .architecture-layer-icon {
    width: 48px;
    height: 48px;
  }

  .architecture-layer-heading {
    flex-direction: column;
    gap: 10px;
  }

  .architecture-boundary {
    padding: 24px;
  }

  .boundary-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .architecture-hero-panel {
    min-height: 290px;
  }

  .architecture-node {
    width: 120px;
    height: 120px;
    border-radius: 25px;
  }

  .architecture-orbit-one {
    width: 190px;
    height: 190px;
  }

  .architecture-orbit-two {
    width: 260px;
    height: 150px;
  }

  .architecture-orbit-three {
    width: 320px;
    height: 220px;
  }

  .architecture-layer {
    grid-template-columns: 1fr;
  }

  .architecture-stack::before {
    display: none;
  }

  .architecture-layer-index {
    padding-top: 0;
  }
}
