.app-shell {
  min-height: 100vh;
  display: flex;
  color: var(--text);
  background:
    radial-gradient(circle at 50% -10%, rgba(139, 92, 246, 0.08), transparent 30rem),
    transparent;
}

.app-shell a {
  text-decoration: none;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 40;
  width: 272px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--border);
  background: rgba(7, 8, 13, 0.82);
  backdrop-filter: blur(26px);
  -webkit-backdrop-filter: blur(26px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
  height: 82px;
  padding: 0 22px;
  border-bottom: 1px solid var(--border);
}

.brand-mark {
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 0 30px rgba(109, 40, 217, 0.2);
}

.brand-mark img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
}

.brand strong {
  display: block;
  color: var(--text-bright);
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.brand small {
  display: block;
  margin-top: 3px;
  color: var(--text-soft);
  font-family: var(--mono);
  font-size: 0.63rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.navigation {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 5px;
  padding: 24px 14px;
  overflow-y: auto;
}

.nav-label {
  padding: 0 12px 9px;
  color: #525a6d;
  font-family: var(--mono);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.navigation a {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 43px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 11px;
  color: #80889c;
  font-size: 0.87rem;
  transition:
    color 180ms ease,
    background 180ms ease,
    border-color 180ms ease,
    transform 180ms ease;
}

.navigation a:hover {
  color: #dfe3ed;
  background: rgba(255, 255, 255, 0.035);
  border-color: var(--border);
  transform: translateX(2px);
}

.navigation a.active {
  color: #fff;
  background:
    linear-gradient(90deg, rgba(109, 40, 217, 0.2), rgba(109, 40, 217, 0.06));
  border-color: rgba(139, 92, 246, 0.2);
  box-shadow: inset 2px 0 0 var(--violet);
}

.navigation a svg {
  width: 17px;
  height: 17px;
}

.sidebar-footer {
  padding: 17px;
  border-top: 1px solid var(--border);
}

.company-signature {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 0 4px 13px;
}

.company-signature span {
  color: #525a6d;
  font-family: var(--mono);
  font-size: 0.56rem;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.company-signature strong {
  color: #8e96a9;
  font-size: 0.64rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.network-indicator {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 11px 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.025);
  color: #8e96a9;
  font-family: var(--mono);
  font-size: 0.66rem;
  letter-spacing: 0.04em;
}

.live-dot {
  width: 6px;
  height: 6px;
  flex: 0 0 6px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 12px rgba(52, 211, 153, 0.7);
}

.main-content {
  width: calc(100% - 272px);
  min-width: 0;
  min-height: 100vh;
  margin-left: 272px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 66px;
  padding: 0 34px;
  border-bottom: 1px solid var(--border);
  background: rgba(7, 8, 13, 0.66);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.topbar-context {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #8e96a9;
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.live-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 9px;
  border: 1px solid rgba(52, 211, 153, 0.18);
  border-radius: 999px;
  color: #7ce7b9;
  background: rgba(52, 211, 153, 0.055);
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.mobile-menu {
  display: none;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text);
  background: rgba(255, 255, 255, 0.03);
}

.page-content {
  width: min(100%, 1440px);
  margin: 0 auto;
  padding: 72px 54px 100px;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
  gap: 50px;
  align-items: center;
  min-height: 650px;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
  color: #8b95aa;
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.eyebrow-line {
  width: 34px;
  height: 1px;
  background: linear-gradient(90deg, var(--cyan), transparent);
}

.hero-copy h1 {
  max-width: 850px;
}

.hero-copy h1 span {
  background: linear-gradient(110deg, #fff 10%, #b7a1ff 48%, #67e8f9 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-copy > p {
  max-width: 660px;
  margin-top: 28px;
  color: #8d95a8;
  font-size: 1.02rem;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 11px;
  margin-top: 34px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 46px;
  padding: 0 17px;
  border-radius: 10px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease;
}

.primary-button {
  color: #fff;
  border: 1px solid rgba(139, 92, 246, 0.55);
  background: linear-gradient(135deg, #7c3aed, #5b21b6);
  box-shadow: 0 10px 30px rgba(91, 33, 182, 0.25);
}

.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-2px);
}

.primary-button:hover {
  box-shadow: 0 14px 40px rgba(91, 33, 182, 0.34);
}

.secondary-button {
  color: #d4d8e3;
  border: 1px solid var(--border-strong);
  background: rgba(255, 255, 255, 0.035);
}

.secondary-button:hover {
  border-color: rgba(139, 92, 246, 0.35);
  background: rgba(255, 255, 255, 0.055);
}

.hero-panel {
  position: relative;
  min-height: 510px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 28px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 48%, rgba(109, 40, 217, 0.16), transparent 13rem),
    radial-gradient(circle at 50% 50%, rgba(34, 211, 238, 0.045), transparent 20rem),
    rgba(9, 10, 17, 0.68);
  box-shadow: var(--shadow-lg), var(--shadow-glow);
}

.hero-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, transparent 49.8%, rgba(139, 92, 246, 0.08) 50%, transparent 50.2%),
    linear-gradient(0deg, transparent 49.8%, rgba(139, 92, 246, 0.08) 50%, transparent 50.2%);
  background-size: 100% 100%;
  pointer-events: none;
}

.hero-orbit {
  position: relative;
  width: min(390px, 75vw);
  aspect-ratio: 1;
  display: grid;
  place-items: center;
}

.orbit {
  position: absolute;
  border: 1px solid rgba(139, 92, 246, 0.18);
  border-radius: 50%;
  transform: rotate(-22deg) rotateX(62deg);
}

.orbit-one {
  width: 94%;
  height: 40%;
}

.orbit-two {
  width: 75%;
  height: 29%;
  transform: rotate(42deg) rotateX(62deg);
  border-color: rgba(34, 211, 238, 0.16);
}

.orbit-core {
  position: relative;
  z-index: 2;
  width: 42%;
  aspect-ratio: 1;
  padding: 3%;
  border: 1px solid rgba(139, 92, 246, 0.35);
  border-radius: 30px;
  background: rgba(10, 11, 19, 0.5);
  box-shadow:
    0 0 80px rgba(109, 40, 217, 0.24),
    inset 0 0 40px rgba(139, 92, 246, 0.08);
}

.orbit-core img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
  border-radius: 22px;
}

.section-block {
  margin-top: 74px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.section-heading p {
  max-width: 620px;
  color: var(--text-soft);
  font-size: 0.9rem;
  line-height: 1.65;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.metric-card,
.module-card,
.protocol-strip,
.placeholder-page {
  border: 1px solid var(--border);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.018));
  box-shadow: 0 14px 50px rgba(0, 0, 0, 0.14);
}

.metric-card {
  min-height: 132px;
  padding: 22px;
  border-radius: 15px;
}

.metric-card small {
  display: block;
  color: #626b7e;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.metric-card strong {
  display: block;
  margin-top: 14px;
  color: #f7f8fc;
  font-family: var(--mono);
  font-size: 1.18rem;
  letter-spacing: -0.03em;
}

.metric-card p {
  margin-top: 5px;
  color: #697285;
  font-size: 0.74rem;
}

.metric-live strong {
  color: #76e5b6;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 11px;
}

.module-card {
  min-height: 205px;
  padding: 23px;
  border-radius: 16px;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.module-card:hover {
  transform: translateY(-3px);
  border-color: var(--border-strong);
  background:
    linear-gradient(145deg, rgba(139, 92, 246, 0.075), rgba(255, 255, 255, 0.025));
}

.module-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
}

.module-icon,
.protocol-icon,
.placeholder-icon {
  display: grid;
  place-items: center;
  border: 1px solid rgba(139, 92, 246, 0.22);
  color: #b49aff;
  background: var(--violet-soft);
}

.module-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
}

.module-icon svg {
  width: 18px;
  height: 18px;
}

.module-card h3 {
  margin-top: 25px;
}

.module-card p {
  margin-top: 8px;
  color: #737c90;
  font-size: 0.79rem;
  line-height: 1.6;
}

.module-arrow {
  color: #515a6e;
  transition: color 180ms ease, transform 180ms ease;
}

.module-card:hover .module-arrow {
  color: var(--cyan);
  transform: translate(2px, -2px);
}

.protocol-strip {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 18px;
  align-items: center;
  padding: 22px;
  border-radius: 15px;
  background:
    linear-gradient(110deg, rgba(109, 40, 217, 0.095), rgba(34, 211, 238, 0.025)),
    rgba(255, 255, 255, 0.02);
}

.protocol-icon {
  width: 42px;
  height: 42px;
  border-radius: 11px;
}

.protocol-strip strong {
  color: #e8eaf1;
  font-size: 0.84rem;
}

.protocol-strip p {
  margin-top: 3px;
  color: #727b8f;
  font-size: 0.76rem;
}

.external-link,
.text-link {
  color: #b4a1ff;
  transition: color 180ms ease;
}

.external-link:hover,
.text-link:hover {
  color: var(--cyan);
}

.placeholder-page {
  min-height: 620px;
  display: grid;
  place-items: center;
  padding: 50px;
  border-radius: 22px;
  text-align: center;
  background:
    radial-gradient(circle at center, rgba(109, 40, 217, 0.09), transparent 22rem),
    rgba(255, 255, 255, 0.018);
}

.placeholder-page > div {
  max-width: 660px;
}

.placeholder-icon {
  width: 62px;
  height: 62px;
  margin: 0 auto 24px;
  border-radius: 17px;
}

.placeholder-page h2 {
  margin-bottom: 13px;
}

.placeholder-page p {
  color: #747d90;
  line-height: 1.75;
}

.sidebar-backdrop {
  display: none;
}

@media (max-width: 1180px) {
  .sidebar {
    width: 238px;
  }

  .main-content {
    width: calc(100% - 238px);
    margin-left: 238px;
  }

  .page-content {
    padding-inline: 34px;
  }

  .hero-grid {
    gap: 30px;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .sidebar {
    transform: translateX(-102%);
    transition: transform 220ms ease;
    box-shadow: 20px 0 60px rgba(0, 0, 0, 0.45);
  }

  .sidebar.sidebar-open {
    transform: translateX(0);
  }

  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    z-index: 35;
    display: block;
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(4px);
  }

  .main-content {
    width: 100%;
    margin-left: 0;
  }

  .mobile-menu {
    display: inline-flex;
  }

  .topbar {
    padding-inline: 20px;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .hero-copy {
    padding-top: 24px;
  }

  .hero-panel {
    min-height: 420px;
  }

  .module-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .page-content {
    padding: 40px 17px 70px;
  }

  .topbar {
    height: 60px;
  }

  .topbar-context {
    font-size: 0.6rem;
  }

  .hero-grid {
    gap: 28px;
  }

  .hero-copy h1 {
    font-size: clamp(2.65rem, 14vw, 4rem);
  }

  .hero-copy > p {
    font-size: 0.92rem;
  }

  .hero-panel {
    min-height: 350px;
    border-radius: 20px;
  }

  .metrics-grid,
  .module-grid {
    grid-template-columns: 1fr;
  }

  .section-block {
    margin-top: 52px;
  }

  .section-heading {
    display: block;
  }

  .section-heading p {
    margin-top: 9px;
  }

  .protocol-strip {
    grid-template-columns: 1fr;
  }

  .placeholder-page {
    min-height: 500px;
    padding: 30px 20px;
  }
}
